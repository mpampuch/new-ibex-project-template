// conf/test.config — the "test" profile.
// Launch on IBEX with `-profile singularity,test` (or `docker,test` locally).
// See instructions/nf-core-pipeline-building.md §4.6.
params {
    // Point the test run at the small, subsetted test sample sheet.
    input = "${projectDir}/samplesheet.test.csv"

    // Examples of test-only overrides (point references at small test refs):
    // reference   = "${projectDir}/TESTDATA/reference"
    // single_end  = true
}
