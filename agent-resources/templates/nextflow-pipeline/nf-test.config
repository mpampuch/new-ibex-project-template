// nf-test.config — nf-test harness for this pipeline.
// IBEX: profile "test,singularity"   local: profile "test,docker".
// See agent-resources/instructions/nf-core-pipeline-building.md §4.2.

config {
    // location for all nf-test tests
    testsDir "."

    // nf-test working directory including per-test state
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"

    // nextflow.config used when executing the tests
    configFile "tests/nextflow.config"

    // Pull-in tests from the nf-core modules/subworkflows repos are ignored by
    // default; trust them as working. NARROW or REMOVE this to actually run a
    // pulled-in module's tests on this site, then verify with `nf-test list`.
    //   ignore 'modules/nf-core/!(your_tool)/**/tests/*', 'subworkflows/nf-core/**/tests/*'
    ignore 'modules/nf-core/**/tests/*', 'subworkflows/nf-core/**/tests/*'

    // load helper groovy functions — REQUIRED for DebugUtils.printTree
    libDir "tests/lib"

    // run every test with this profile (IBEX vs local differ only here)
    profile "test,singularity"

    // re-run the full suite when any of these change
    triggers 'nextflow.config', 'nf-test.config', 'conf/test.config', 'tests/nextflow.config', 'tests/.nftignore'

    // load the necessary plugins
    plugins {
        load "nft-utils@0.0.3"
    }
}
